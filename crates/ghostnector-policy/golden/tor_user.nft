destroy table inet ghostnector
table inet ghostnector {
    chain out_nat {
        type nat hook output priority -150; policy accept;
        meta skuid != 1000 counter return comment "outside the scope, leave the machine alone"
        oifname "lo" counter return comment "loopback cannot reach the clearnet"
        meta skuid 987 counter return comment "Tor's own egress must not be captured"
        udp dport 53 counter redirect to :9054 comment "DNS goes to the chokepoint"
        tcp dport 53 counter redirect to :9054 comment "DNS goes to the chokepoint"
        meta l4proto tcp counter redirect to :9040 comment "transparent Tor for TCP"
    }
    chain out_filter {
        type filter hook output priority -150; policy drop;
        meta skuid != 1000 counter accept comment "outside the scope, leave the machine alone"
        oifname "lo" counter accept comment "loopback cannot reach the clearnet"
        meta skuid 987 counter accept comment "Tor's own egress"
        udp dport 68 counter accept comment "keep the link alive"
        meta l4proto udp counter reject with icmpx type port-unreachable comment "QUIC and real-time clients must fail in milliseconds, not hang"
        meta l4proto icmp counter reject with icmpx type admin-prohibited comment "ICMP is not carried by Tor"
        meta l4proto ipv6-icmp counter reject with icmpx type admin-prohibited comment "IPv6 is denied in every profile"
        counter drop comment "deny by default"
    }
    chain fwd_filter {
        type filter hook forward priority -150; policy drop;
        counter drop comment "containers and virtual machines must not leak around the output chain"
    }
    chain in_filter {
        type filter hook input priority -150; policy accept;
        iifname "lo" counter accept comment "loopback delivery of redirected traffic"
        tcp dport 9040 counter drop comment "the transparent proxies are not for the network"
        tcp dport 9054 counter drop comment "the transparent proxies are not for the network"
        tcp dport 9050 counter drop comment "the transparent proxies are not for the network"
    }
}
