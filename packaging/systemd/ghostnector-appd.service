[Unit]
Description=Ghostnector APP-scope namespace helper (dead-end namespaces)
Documentation=file:/usr/share/doc/ghostnector/README.md file:/usr/share/doc/ghostnector/RECOVERY.md
# The control plane starts before any transition needs this helper, and the boot guard must not wait
# on it: APP namespaces are volatile by design and nothing at boot depends on them.
DefaultDependencies=no
After=local-fs.target systemd-tmpfiles-setup.service ghostnector-netd.service
Before=sysinit.target
Conflicts=shutdown.target
Before=shutdown.target
# A start that can never succeed (for example a missing /run/netns, D-33) must not restart forever:
# without an explicit bound the unit was observed restarting more than a thousand times in half an
# hour. Ten attempts in a minute is generous for transient trouble and bounded for a permanent one;
# after that the unit stays failed and is visible in `systemctl --failed`. These keys belong in
# [Unit]; systemd ignores them in [Service] (which is where they were first put, D-33).
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=exec
ExecStart=/usr/libexec/ghostnector-appd \
    --socket /run/ghostnector/appd/appd.sock \
    --peer-user ghostnector \
    --state-dir /run/ghostnector/apps \
    --launcher /usr/libexec/ghostnector-appd-launch \
    --bridge ghbr0 \
    --core 10.200.0.1 \
    --prefix 24 \
    --dead-device ghdead

# The minimum that does the work, measured (the M8.2 gate runs this helper under this exact
# capability state and under the same state minus CAP_SYS_ADMIN):
#   * creating a namespace (unshare) and entering one (setns) need CAP_SYS_ADMIN;
#   * links, addresses, routes, bridge membership and per-namespace sysctls need CAP_NET_ADMIN;
#   * handing the socket to the control plane's uid needs CAP_CHOWN (the mode is set before the
#     chown, so CAP_FOWNER is not needed and the socket is never briefly peer-owned with a
#     permissive mode).
# The helper runs as root, so the bounding set above is also the permitted and effective set
# (measured on the installed machine: cap_chown,cap_sys_admin,cap_net_admin+ep). Only
# CAP_NET_ADMIN is ambient, so the tools this helper runs (`ip`, `bridge`, `nft`) never inherit
# CAP_SYS_ADMIN or CAP_CHOWN. There is no `KeepCapabilities=` directive in systemd; an earlier
# revision of this unit named one, and systemd ignored it (D-36).
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_CHOWN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=yes

# It speaks netlink and unix sockets. It never opens an internet socket itself.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
# `net` for the namespaces it owns; `mnt` for the launch helper's private mount namespace, which
# bind-mounts each group's resolver configuration over /etc/resolv.conf.
RestrictNamespaces=net mnt
# `ip netns add` makes /run/netns a shared mount so a named namespace can persist; `mount` is not
# part of `@system-service`, so without `@mount` the helper's every namespace creation failed with
# EPERM on the installed product (D-44). The helper already holds CAP_SYS_ADMIN for exactly this
# work; the filter is what made it unreachable.
SystemCallFilter=@system-service @mount
SystemCallErrorNumber=EPERM
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ReadWritePaths=/run/ghostnector /run/netns

Restart=on-failure
RestartSec=2

[Install]
WantedBy=sysinit.target
