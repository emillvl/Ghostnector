[Unit]
Description=Ghostnector boot guard (deny everything if protection was requested)
Documentation=file:/usr/share/doc/ghostnector/README.md file:/usr/share/doc/ghostnector/RECOVERY.md
# Early, and before the network is configured: an application that starts sending during boot must
# find the machine already denied.
DefaultDependencies=no
After=local-fs.target systemd-tmpfiles-setup.service ghostnector-netd.service
Wants=ghostnector-netd.service
Before=sysinit.target network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
# It runs as the control plane's own user: netd hands both its socket and the fail-closed copy to
# that user, so the guard can reach them with no capability that bypasses file permissions. It needs
# exactly one capability, NET_ADMIN, to apply the ruleset with nft.
User=ghostnector
Group=ghostnector
ExecStart=/usr/libexec/ghostnector-bootguard \
    --netd /run/ghostnector/netd/netd.sock \
    --intent /var/lib/ghostnector/intent.json \
    --fallback /var/lib/ghostnector-netd/fail-closed.nft

# It may apply the helper's own copy of the policy, so it needs the capability to do that - and
# nothing else. In particular there is no CAP_DAC_OVERRIDE or CAP_DAC_READ_SEARCH: the files it
# reads are owned by the user it runs as (D-54).
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=yes

# Refusing to run because something looked odd would leave the machine open, which is worse: the
# program is deliberately allowed to reach the policy tool.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectProc=invisible
ProcSubset=pid
# The guard only reads (the intent, the copy, the helper's socket); it writes nothing, so it has no
# state directory and no writable path at all.

[Install]
WantedBy=sysinit.target
