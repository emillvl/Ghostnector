[Unit]
Description=I2P router for Ghostnector (a client of the I2P network, configured by Ghostnector)
Documentation=man:i2pd(1)
# Started and stopped by the control plane, not at boot: the router has no business running when
# nothing is being protected, and the control plane writes its configuration before starting it.
After=ghostnector-netd.service

[Service]
Type=exec
User=i2pd
Group=i2pd
# The router resolves its home from $HOME and looks for `$HOME/.i2pd` before anything else. The
# i2pd package's user has home /home/i2pd, which does not exist, and ProtectHome=yes below masks
# /home anyway, so without this the router aborts with "filesystem error: status: Permission
# denied [/home/i2pd/.i2pd]" and the unit crash-loops (D-40). Its own state directory is a home
# that exists and is writable.
Environment=HOME=/var/lib/ghostnector-i2pd
# The package ships the certificates i2pd needs to verify reseed material; without --certsdir the
# router looks under $HOME and reports that it cannot load them.
ExecStart=/usr/bin/i2pd --conf=/run/ghostnector/i2pd.conf --certsdir=/usr/share/i2pd/certificates
# The configuration is written by the control plane, which is why this unit does not own it.
ReadOnlyPaths=/run/ghostnector/i2pd.conf

# The router needs no capabilities at all. It is an ordinary unprivileged process; the policy is
# what confines everything else, and the router's own egress is the one exemption that makes the
# network reachable.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
# Its own data directory, and the configuration the control plane writes.
ReadWritePaths=/var/lib/ghostnector-i2pd /run/ghostnector
StateDirectory=ghostnector-i2pd
Restart=on-failure
RestartSec=3

[Install]
# Not enabled: only the control plane starts it.
WantedBy=multi-user.target
