[Unit]
Description=Ghostnector privileged helper (the only writer of the network policy)
Documentation=file:/usr/share/doc/ghostnector/README.md file:/usr/share/doc/ghostnector/RECOVERY.md
# Deliberately early: the boot guard runs before sysinit and needs this helper to exist by then.
DefaultDependencies=no
After=local-fs.target systemd-tmpfiles-setup.service
Before=sysinit.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=exec
ExecStart=/usr/libexec/ghostnector-netd \
    --socket /run/ghostnector/netd/netd.sock \
    --peer-user ghostnector \
    --nft /usr/sbin/nft \
    --conntrack /usr/sbin/conntrack \
    --fallback-path /var/lib/ghostnector-netd/fail-closed.nft \
    --tor-user debian-tor \
    --dnscrypt-user dnscrypt-proxy

# The whole point of this process is that it holds the least that lets it work.
#   * CAP_NET_ADMIN writes the policy and flushes conntrack;
#   * CAP_CHOWN hands the socket to the control plane's uid (the mode is set before the chown, so
#     CAP_FOWNER is not needed). Defect D-23: without CAP_CHOWN the helper cannot start under
#     systemd at all.
# Only CAP_NET_ADMIN is ambient, so the `nft` and `conntrack` tools this helper runs inherit
# nothing else.
User=root
CapabilityBoundingSet=CAP_NET_ADMIN CAP_CHOWN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=yes

# It speaks netlink to the kernel and unix sockets to the control plane. Nothing else.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
# The fallback policy file lives here; the helper's own state directory is root-owned (it runs as
# root), which is what lets it write the copy without a capability that bypasses file permissions,
# and it hands the finished copy to the control plane's user. The core's journal lives in
# /var/lib/ghostnector, which this unit no longer needs: keeping the two directories apart also ends
# the latent ownership fight over the shared one (D-54). systemd creates this directory before the
# unit's namespaces are set up, so a fresh install cannot fail with 226/NAMESPACE (D-52).
StateDirectory=ghostnector-netd
ReadWritePaths=/run/ghostnector /var/lib/ghostnector-netd

Restart=on-failure
RestartSec=2

[Install]
WantedBy=sysinit.target
