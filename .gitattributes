# Ghostnector is a Linux project; the repository is edited from Windows too.
# Force LF for everything that Linux tools will ever execute or parse, so that
# a Windows checkout cannot silently produce CRLF shell scripts or unit files.
* text=auto

*.rs      text eol=lf
*.toml    text eol=lf
*.lock    text eol=lf
*.md      text eol=lf
*.sh      text eol=lf
*.service text eol=lf
*.socket  text eol=lf
*.conf    text eol=lf
*.rules   text eol=lf
*.nft     text eol=lf

# Binary assets are never converted.
*.png binary
*.jpg binary
*.ico binary
*.gz  binary
